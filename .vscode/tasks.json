{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compose: stop app",
      "type": "shell",
      "command": "docker compose stop backend frontend",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "postgres: up",
      "type": "shell",
      "command": "docker compose up -d postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "dev: prepare",
      "dependsOrder": "sequence",
      "dependsOn": [
        "compose: stop app",
        "postgres: up"
      ],
      "problemMatcher": []
    },
    {
      "label": "postgres: down",
      "type": "shell",
      "command": "docker compose stop postgres",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
