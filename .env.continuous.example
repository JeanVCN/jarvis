# Copy to ignored .env.continuous, then: set -a; . ./.env.continuous; set +a
DATABASE_URL=postgres://jarvis:jarvis@127.0.0.1:5432/jarvis?sslmode=disable
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
CORS_ALLOWED_ORIGIN=http://127.0.0.1:13000,http://localhost:13000
JARVIS_ALLOWED_ORIGINS=http://127.0.0.1:13000,http://localhost:13000
# For tailnet: append your exact https://node.tailnet.ts.net origin to BOTH lists.
# JARVIS_ICE_ADDRESS=100.x.y.z
JARVIS_GROQ_FREE_CONFIRMED=false
# GROQ_API_KEY= enter securely in your local ignored file, never commit
JARVIS_CODEX_ENABLED=false
# JARVIS_CODEX_HOME=/absolute/path/to/isolated/private/codex-home
# JARVIS_CODEX_BIN=/absolute/path/to/codex
JARVIS_POCKET_LICENSE_ACCEPTED=false
JARVIS_ALLOW_SYSTEM_TOOLS=false
