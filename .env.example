APP_ENV=development

POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_PORT=5432

BACKEND_HOST=0.0.0.0
BACKEND_PORT=18080
BACKEND_CONTAINER_PORT=18080
DATABASE_URL=postgres://jarvis:jarvis@postgres:5432/jarvis?sslmode=disable
CORS_ALLOWED_ORIGIN=http://127.0.0.1:13000,http://localhost:13000
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
VOICE_STT_COMMAND=faster-whisper
VOICE_STT_ARGS={input} --language {language} --model {model} --output_format txt --output_dir {output_dir}
VOICE_STT_MODEL=tiny
VOICE_STT_LANGUAGE=pt
VOICE_TTS_COMMAND=piper
VOICE_TTS_ARGS=--model {voice} --output_file {output}
VOICE_TTS_VOICE=

FRONTEND_PORT=13000
API_INTERNAL_URL=http://backend:18080
NEXT_PUBLIC_API_URL=http://127.0.0.1:18080
