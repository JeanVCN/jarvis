[Unit]
Description=Jarvis OpenCode bridge
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=@JARVIS_BRIDGE_DIR@
Environment=HOME=%h
EnvironmentFile=%h/.config/jarvis/opencode-bridge.env
ExecStart=@NODE_BINARY@ dist/server.js
Restart=on-failure
RestartSec=10s
TimeoutStopSec=20s
UMask=0077
Nice=5
CPUWeight=50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
