[Unit]
Description=Jarvis WhatsApp channel (%i)
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
Environment=HOME=%h
Environment=JARVIS_CODEX_ENABLED=true
Environment=JARVIS_CODEX_HOME=%h/.codex
EnvironmentFile=%h/.config/jarvis/whatsapp-%i.env
EnvironmentFile=-%h/.config/jarvis/opencode-bridge.env
ExecStart=%h/.local/lib/jarvis/whatsapp/%i
Restart=on-failure
RestartSec=10s
TimeoutStopSec=30s
UMask=0077
Nice=5
CPUWeight=50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
